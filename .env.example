# URL pública del sitio, sin barra final (usada para SEO: sitemap.xml, robots.txt, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://waistenprogramacion.com.ar

# ID del contenedor de Google Tag Manager (formato GTM-XXXXXXX)
# Google Tag Manager > Administrador > Instalar Tag Manager
# Si no se define, se usa GTM-K2MM29SC (el contenedor ya creado para este sitio)
# La configuración de Google Analytics 4 y las conversiones de Google Ads se hacen
# dentro de Tag Manager (agregando etiquetas), no acá.
NEXT_PUBLIC_GTM_ID=GTM-K2MM29SC

# Código de verificación de propiedad de Google Search Console
# Search Console > Configuración > Verificación de propiedad > método "Etiqueta HTML" > copiar solo el valor de content="..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
