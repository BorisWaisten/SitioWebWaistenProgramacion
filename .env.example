# URL pública del sitio, sin barra final (usada para SEO: sitemap.xml, robots.txt, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://waistenprogramacion.com.ar

# ID de medición de Google Analytics 4
# Google Analytics > Administrar > Flujos de datos > Web > ID de medición (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Código de verificación de propiedad de Google Search Console
# Search Console > Configuración > Verificación de propiedad > método "Etiqueta HTML" > copiar solo el valor de content="..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
